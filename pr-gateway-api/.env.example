# Azure DevOps connection
ADO_ORG_URL=https://dev.azure.com/YourOrganization
ADO_PROJECT=YourProject
ADO_SERVICE_PAT=your_ado_service_pat_here

# Allowed repositories (* for all, or comma-separated: repo1,repo2)
ADO_ALLOWED_REPOS=*

# Allowed target branches
ADO_ALLOWED_TARGET_BRANCHES=dev,stage,preprod,prod,main,master

# Reviewers comma-separated
ADO_REVIEWERS=lead1@company.com,lead2@company.com,lead3@company.com,lead4@company.com,lead5@company.com

# Mock Auth / Dev Mode (true for local test without Entra ID token)
PR_GATEWAY_DEV_MODE=false
DEV_USER_NAME=Developer Name
DEV_USER_EMAIL=dev@company.com
